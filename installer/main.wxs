<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Rust Desktop Icons" Manufacturer="vincentxjoubert-lang" Version="$(Version)" UpgradeCode="EC06B7E9-B60A-4EFC-9A07-9FC0C215C3B2" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Rust Desktop Icons is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vincentxjoubert-lang/rust-desktop-icons" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Rust Desktop Icons">
          <Component Id="Main" Guid="79D2DEC3-4F44-4179-BFB3-1815BE425E09">
            <File Id="Exe" Source="target\release\rust-desktop-icons.exe" />
            <File Id="License" Source="LICENSE" Name="LICENSE.txt" />
            <RegistryValue Root="HKCU" Key="Software\RustDesktopIcons" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="RustDesktopIcons" Type="string" Value="&quot;[INSTALLFOLDER]rust-desktop-icons.exe&quot;" />
            <RemoveFolder Id="RemoveInstall" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemovePrograms" Directory="ProgramsDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut Id="StartShortcut" Name="Rust Desktop Icons" Target="[INSTALLFOLDER]rust-desktop-icons.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RustDesktopIcons" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <CustomAction Id="Launch" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]rust-desktop-icons.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="Launch" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
